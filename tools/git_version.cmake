# Generate a version header from git on every build (shown in options About, shared by Vita/PSP).
# Usage: cmake -DSRC=<repo root> -DOUT=<rei_version.h> -P tools/git_version.cmake
# Version = latest tag vX.Y.Z plus N commits since: vX.Y.(Z+N) (last digit rises every commit even without tags).
# Without tags: v0.0.<total commit count>. Uncommitted changes append -dirty.
# The file is not rewritten if the content is unchanged (avoids recompiling)

if(NOT SRC OR NOT OUT)
  message(FATAL_ERROR "git_version: SRC and OUT are required")
endif()

set(VER "unknown")
set(DATE "")
find_package(Git QUIET)
if(GIT_FOUND)
  execute_process(COMMAND "${GIT_EXECUTABLE}" describe --tags --match "v[0-9]*" --long --dirty
    WORKING_DIRECTORY "${SRC}" OUTPUT_VARIABLE OUTV RESULT_VARIABLE RC
    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(RC EQUAL 0 AND OUTV MATCHES "^v([0-9]+)\\.([0-9]+)\\.([0-9]+)-([0-9]+)-g[0-9a-f]+(-dirty)?$")
    math(EXPR PATCH "${CMAKE_MATCH_3} + ${CMAKE_MATCH_4}")
    set(VER "v${CMAKE_MATCH_1}.${CMAKE_MATCH_2}.${PATCH}${CMAKE_MATCH_5}")
  else()
    execute_process(COMMAND "${GIT_EXECUTABLE}" rev-list --count HEAD
      WORKING_DIRECTORY "${SRC}" OUTPUT_VARIABLE OUTN RESULT_VARIABLE RC
      OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(RC EQUAL 0)
      set(VER "v0.0.${OUTN}")
    endif()
  endif()
  execute_process(COMMAND "${GIT_EXECUTABLE}" log -1 --format=%cd --date=short
    WORKING_DIRECTORY "${SRC}" OUTPUT_VARIABLE OUTD RESULT_VARIABLE RC
    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(RC EQUAL 0)
    set(DATE "${OUTD}")
  endif()
endif()

set(TEXT "// generated by tools/git_version.cmake at build time\n#define REI_VERSION \"${VER}\"\n#define REI_VERSION_DATE \"${DATE}\"\n")
if(EXISTS "${OUT}")
  file(READ "${OUT}" OLD)
endif()
if(NOT OLD STREQUAL TEXT)
  file(WRITE "${OUT}" "${TEXT}")
endif()
