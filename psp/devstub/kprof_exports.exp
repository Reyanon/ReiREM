# nbbkprof kernel module exports (psp-build-exports). nbbk_counter is called from user mode via syscall (0x4001)
PSP_BEGIN_EXPORTS

PSP_EXPORT_START(syslib, 0, 0x8000)
PSP_EXPORT_FUNC_HASH(module_start)
PSP_EXPORT_FUNC_HASH(module_stop)
PSP_EXPORT_VAR_HASH(module_info)
PSP_EXPORT_END

PSP_EXPORT_START(nbbkprof, 0, 0x4001)
PSP_EXPORT_FUNC(nbbk_counter)
PSP_EXPORT_END

PSP_END_EXPORTS
